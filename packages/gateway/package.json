{
  "name": "anymcp-gateway",
  "version": "0.1.0",
  "description": "One MCP server for every website: search, browse and call community site tools from your AI.",
  "type": "module",
  "license": "MIT",
  "author": "Hassan Anwar",
  "homepage": "https://github.com/hassan-algo/anymcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hassan-algo/anymcp.git",
    "directory": "packages/gateway"
  },
  "bugs": {
    "url": "https://github.com/hassan-algo/anymcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "browser",
    "claude",
    "cursor",
    "tools",
    "chrome-extension"
  ],
  "bin": {
    "anymcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/registry-index.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "bundle": "node scripts/build.mjs",
    "build": "npm run typecheck && npm run bundle",
    "start": "node dist/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@anymcp/shared": "*",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  }
}
