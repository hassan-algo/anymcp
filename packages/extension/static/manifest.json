{
  "manifest_version": 3,
  "name": "AnyMCP",
  "version": "0.1.0",
  "key": "",
  "description": "Turn any website into tools your AI can use, through one MCP server.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AnyMCP",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
